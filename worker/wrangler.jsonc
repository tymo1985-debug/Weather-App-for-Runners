{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "run-weather-watch",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "..",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "WATCH_STORE", "class_name": "WatchStore" }
    ]
  },
  "exports": {
    "WatchStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
